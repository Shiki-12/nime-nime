generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

enum BroadcastType {
  INFO
  WARNING
  DANGER
  SUCCESS
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              Role      @default(USER)
  isVerified        Boolean   @default(false)
  nsfwEnabled       Boolean   @default(false)
  verifyToken       String?
  verifyTokenExpiry DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  savedAnime      SavedAnime[]
  watchHistory    WatchHistory[]
  comments        Comment[]
  publicMessages  PublicMessage[]
  recommendations Recommendation[]
  notifications   Notification[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SavedAnime {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  title     String
  image     String
  type      String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@map("saved_anime")
}

model WatchHistory {
  id          String   @id @default(cuid())
  userId      String
  animeId     String
  title       String
  image       String
  type        String   @default("")
  episodeId   String
  episodeName String   @default("")
  watchedAt   DateTime @default(now())
  progress    Float    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId, episodeId])
  @@map("watch_history")
}

// ─── Public Discuss Models ──────────────────────────────────────────

model Comment {
  id          String   @id @default(cuid())
  userId      String
  text        String
  episodeSlug String
  animeSlug   String?
  parentId    String?
  createdAt   DateTime @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReplies")

  @@index([createdAt])
  @@map("comments")
}

model PublicMessage {
  id        String   @id @default(cuid())
  userId    String
  message   String
  parentId  String?
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PublicMessage? @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies PublicMessage[] @relation("MessageReplies")

  @@index([createdAt])
  @@map("public_messages")
}

model Recommendation {
  id         String   @id @default(cuid())
  userId     String
  animeSlug  String
  animeTitle String
  coverImage String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("recommendations")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'REPLY', 'NEW_EPISODE', 'SYSTEM'
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Broadcast {
  id        String        @id @default(cuid())
  message   String
  type      BroadcastType @default(INFO)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@index([isActive, startDate, endDate])
  @@map("broadcasts")
}
